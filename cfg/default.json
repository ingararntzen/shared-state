{
    "service": {
        "host": "0.0.0.0",
        "port": 9000,
        "http_log": "logs/http.log",
        "ws_log": "logs/ws.log"
    },
    "stores": [
        {
            "name": "items",
            "module": "item_store",
            "description": "SQLite In-Memory Item Store",
            "config": {
                "db_type": "sqlite",
                "db_name": ":memory:",
                "db_table": "items"
            }
        }
    ]
}
