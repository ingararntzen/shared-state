{
  "name": "sharedstate",
  "version": "1.0.0",
  "description": "SharedState",
  "type": "module",
  "main": "dist/sharedstate.cjs.js",
  "module": "dist/sharedstate.es.js",
  "exports": {
    ".": {
      "import": "./dist/sharedstate.es.js",
      "require": "./dist/sharedstate.cjs.js",
      "browser": "./dist/sharedstate.es.js",
      "node": "./dist/sharedstate.cjs.js",
      "default": "./dist/sharedstate.es.js"
    }
  },
  "files": [
    "dist",
    "client"
  ],
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:js": "vitest run",
    "test:watch": "vitest",
    "build": "vite build && DIST=true vite build",
    "build:dist": "vite build && DIST=true vite build",
    "prepublishOnly": "npm run build:dist",
    "docs:generate": "node scripts/generate-api-docs.js",
    "docs:dev": "npm run docs:generate && vitepress dev docs",
    "docs:build": "npm run docs:generate && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "node scripts/release.js",
    "version": "node scripts/release.js --sync-only && git add pyproject.toml src/sharedstate/__init__.py dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingararntzen/shared-state.git"
  },
  "keywords": [
    "real-time",
    "data-sharing",
    "websocket-server"
  ],
  "author": "Ingar M. Arntzen",
  "license": "BSD-2",
  "bugs": {
    "url": "https://github.com/ingararntzen/shared-state/issues"
  },
  "homepage": "https://github.com/ingararntzen/shared-state#readme",
  "devDependencies": {
    "jsdoc-to-markdown": "^9.1.3",
    "vite": "^8.1.5",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.10"
  }
}
